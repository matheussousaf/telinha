# --- Web server ---
PORT=3000
# Public base URL of this server. Used to build the links the bot posts and the
# embed thumbnail URLs. For thumbnails to show up in Discord, this must be a
# URL reachable from the internet (e.g. a cloudflared tunnel or your VPS domain).
BASE_URL=http://localhost:3000

# --- Discord bot (leave DISCORD_TOKEN unset to run web-only) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register /screenshare in a single guild (instant) instead of globally (~1h).
GUILD_ID=

# --- WebRTC ---
# STUN default is Google's public server; override if you want.
# STUN_URL=stun:stun.l.google.com:19302
# TURN is optional but strongly recommended once friends on strict NATs join.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_PASSWORD=pass
